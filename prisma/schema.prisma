  client        Contact?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  annualPremium Float            // MAD
  startDate     DateTime         @default(now())
  expiryDate    DateTime
  status        String           @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED
  
  claims        InsuranceClaim[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model InsuranceClaim {
  id           String          @id @default(cuid())
  code         String          @unique // SIN-ASS-2026-0001
  policyId     String
  policy       InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  incidentDate DateTime        @default(now())
  claimType    String          // Dégâts carrosserie, Bris de glace, Vol accessoires, Accident responsable
  claimAmount  Float?
  status       String          @default("INSTRUCTION") // DECLARED, EXPERTISE, INSTRUCTION, PAID, CLOSED
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

