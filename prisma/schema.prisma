model Delivery {
  id            String    @id @default(cuid())
  code          String    @unique // LDV-2026-0001
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  deliveredDate DateTime?
  status        String    @default("PENDING") // PENDING, SCHEDULED, DELIVERED, CANCELLED
  checklistData String?   // JSON checklist items
