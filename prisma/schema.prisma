  channel     String    // WHATSAPP, SMS, EMAIL, APPEL
  direction   String    @default("OUTBOUND") // INBOUND, OUTBOUND
  subject     String?
  content     String
  status      String    @default("SENT") // DRAFT, QUEUED, SENT, DELIVERED, READ, FAILED
  recipientId String?
  recipient   Contact?  @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  senderName  String    @default("MAALAL CARS")
  createdAt   DateTime  @default(now())
}

model CommunicationTemplate {
  id        String   @id @default(cuid())
  name      String
  channel   String   // EMAIL, SMS, WHATSAPP
  category  String   // Ventes, Relance, Bienvenue, Entretien, Devis
  content   String
  createdAt DateTime @default(now())
}

