  docScore      Int       @default(100)
  status        String    @default("VALIDATED") // VALIDATED, NEEDS_REVIEW, REJECTED
  observations  String?   // JSON or text
  beforeAfterPhotos String? // JSON data
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

