  signedAt    DateTime?
  terms       String?
  pdfUrl      String?
  
  partyContactId String?
  partyContact   Contact? @relation(fields: [partyContactId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

