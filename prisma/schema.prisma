  clientId      String?
  client        Contact?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  dossierType   String    @default("Première immatriculation") // Première immatriculation, Mutation Carte Grise, Duplicata, Importation
  region        String    @default("Casablanca-Settat")
  prefecture    String    @default("Anfa")
  feeAmount     Float     @default(800) // MAD
  status        String    @default("IN_PROGRESS") // DRAFT, IN_PROGRESS, PREFECTURE, CARTE_GRISE_READY, COMPLETED
  carteGriseNum String?
  checklistData String?   // JSON
  notes         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
