// ==========================================

model InsurancePolicy {
  id            String           @id @default(cuid())
  code          String           @unique // ASS-2026-0001
  insurerName   String           // AXA Assurance, Allianz, Saham, RMA Watanya, Sanad
  policyType    String           // Tous risques, Tiers étendu, Tiers simple
  vehicleId     String
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
