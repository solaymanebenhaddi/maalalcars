// ==========================================
// 27. CENTRE D'AIDE & SAV SUPPORT
// ==========================================

model HelpdeskTicket {
  id          String    @id @default(cuid())
  code        String    @unique // SUP-2026-0001 ou SAV-2026-0001
  subject     String
  category    String    // Mécanique, Électronique, Carrosserie, Facturation, Délais, Réclamation
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  description String
  assignedTo  String?
  slaDeadline DateTime?
  resolution  String?
  satisfactionRating Int? // 1 - 5
  
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model KnowledgeBaseArticle {
  id        String   @id @default(cuid())
  title     String
  category  String   // Commandes, Livraison, Paiements, Retours & Remboursements, Produits, FAQ
  content   String
  views     Int      @default(0)
  helpful   Int      @default(0)
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 28. NOTIFICATIONS & ARCHIVES
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  category  String   // Stock, Paiements, Documents, Reservations, Factures, Clients, Entretien, System
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL, SUCCESS
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationRule {
  id          String   @id @default(cuid())
  name        String
  triggerType String   // STOCK_AGING, OVERDUE_PAYMENT, EXPIRING_DOC, EXPIRING_RESERVATION, UPCOMING_MAINTENANCE
  condition   String   // "> 90 days", "< 15 days", etc.
  recipient   String   // Admin, Comptabilité, Stock Manager, Atelier
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ArchiveRecord {
  id          String   @id @default(cuid())
  entityType  String   // Vehicle, Contact, Sale, Purchase, Payment
  entityId    String
  entityCode  String
  summary     String
  dataSnapshot String  // JSON snapshot of deleted/archived object
  archivedReason String? // Vente annulée, Doublon, Client inactif, Erreur de saisie, Autre
  archivedBy  String   @default("Admin Maalal")
  archivedAt  DateTime @default(now())
  restoredAt  DateTime?
}
