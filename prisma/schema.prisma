  notes         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==========================================
// 17. ATELIER & ENTRETIEN
// ==========================================

model WorkshopOrder {
  id                   String    @id @default(cuid())
  code                 String    @unique // OT-2025-0128
  vehicleId            String?
  vehicle              Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  clientId             String?
  client               Contact?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  technicianId         String?
  technician           User?     @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  
  serviceType          String    // Entretien périodique, Diagnostic électronique, Remplacement freins AV, Vidange + filtres, etc.
  interventionCategory String?   @default("Entretien") // Entretien, Mécanique, Électronique, Carrosserie, Autres
  priority             String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status               String    @default("IN_PROGRESS") // PLANNED, IN_PROGRESS, WAITING_PARTS, COMPLETED, CANCELLED
  scheduledDate        DateTime  @default(now())
  completedDate        DateTime?
  dueDate              DateTime?
  partsCostHT          Float     @default(0)
  laborCostHT          Float     @default(0)
  taxRate              Float     @default(20.0)
  totalTTC             Float     @default(0)
  notes                String?
  partsList            String?   // JSON list of parts used
  
  vehicleName          String?   // e.g. BMW Série 3 320d 190 ch
  licensePlate         String?   // e.g. WW-123-AA
  mileage              Int?      // e.g. 98450
  technicianName       String?   // e.g. Yassine Benali
  workshopBay          String?   // e.g. Poste 2
  estimatedDuration    String?   // e.g. 2h30
  spentDuration        String?   // e.g. 1h45
  progressPercent      Int?      @default(0)
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ==========================================
// 18. AGENDA & RENDEZ-VOUS
// ==========================================

model Appointment {
  id          String    @id @default(cuid())
  code        String?   @unique // RDV-2025-0137
  title       String
  serviceType String    // Entretien 20 000 km, Contrôle technique, Révision complète, Diagnostic électronique, Vidange + Filtres
  startTime   DateTime
  endTime     DateTime
  status      String    @default("CONFIRMED") // CONFIRMED, PENDING, COMPLETED, CANCELLED
  workshopBay String?   // Atelier 1 – Mécanique, Atelier 2 – Électricité, Atelier 3 – Diagnostic, Carrosserie, Pneumatiques
  reminderMin Int       @default(15) // Reminder X minutes before
  notes       String?
  
  clientId    String?
  client      Contact?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  advisorId   String?
  advisor     User?     @relation(fields: [advisorId], references: [id], onDelete: SetNull)
  
  clientName   String?
  clientPhone  String?
  clientEmail  String?
  vehicleName  String?   // e.g. Peugeot 308, Renault Clio, BMW Série 3
  licensePlate String?   // e.g. WW-123-AA
  vin          String?   // e.g. VF3**************
  mileage      Int?      // e.g. 18450
  advisorName  String?   // e.g. Adem Maalal, Yassine Bejaoui
  source       String?   @default("Téléphone") // Téléphone, WhatsApp, Site web, Email
  duration     String?   @default("01:30")
  repeat       String?   @default("Ne pas répéter")
  history      String?   // JSON timeline events
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==========================================
// 19. LEADS & MARKETING
// ==========================================

model MarketingCampaign {
  id          String    @id @default(cuid())
  name        String
  channel     String    // Google Ads, Facebook Ads, Instagram, Salon Auto, Parrainage, Site Web
  budgetMAD   Float     @default(0)
  spentMAD    Float     @default(0)
  leadsCount  Int       @default(0)
  roiPercent  Float     @default(0)
  status      String    @default("ACTIVE") // ACTIVE, PAUSED, ENDED
  startDate   DateTime  @default(now())
  endDate     DateTime?
  leads       Lead[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Lead {
  id              String             @id @default(cuid())
  code            String             @unique // LEAD-2026-0001
  firstName       String
  lastName        String
  email           String?
  phone           String
  source          String             // Google Ads, Facebook Ads, Instagram, Site web, Parrainage, Walk-in
  interestType    String             @default("Achat d'un véhicule")
  estimatedBudget Float?
  status          String             @default("QUALIFIED") // NEW, CONTACTED, QUALIFIED, PROPOSAL, NEGOTIATION, CONVERTED, LOST
  tags            String?            // JSON tags
  notes           String?
  
  campaignId      String?
  campaign        MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
