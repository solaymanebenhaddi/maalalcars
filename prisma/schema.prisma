}

// ==========================================
// 21. GARANTIES & SINISTRES
// ==========================================

model Warranty {
  id            String          @id @default(cuid())
  code          String          @unique // GAR-2026-0001
  vehicleId     String
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  clientId      String?
  client        Contact?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  warrantyType  String          // Garantie constructeur, Extension garantie, Garantie boîte/moteur
  supplierName  String?         // Toyota Maroc, Premium Warranty
  startDate     DateTime        @default(now())
  endDate       DateTime
  mileageLimit  Int?            @default(120000)
  ceilingAmount Float           @default(15000) // MAD
  deductible    Float           @default(150) // MAD Franchise
  coverageItems String?         // JSON array of covered items
  status        String          @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  
  claims        WarrantyClaim[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model WarrantyClaim {
  id            String    @id @default(cuid())
  code          String    @unique // SIN-2026-0001
  warrantyId    String
  warranty      Warranty  @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  incidentDate  DateTime  @default(now())
  description   String
  estimatedCost Float     // MAD
  approvedCost  Float?
  status        String    @default("IN_PROGRESS") // SUBMITTED, EXPERTISE, APPROVED, REJECTED, REIMBURSED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

