// ==========================================
// 24. TÂCHES & APPROBATIONS
// ==========================================

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  category    String         @default("Operations") // Ventes, Atelier, Livraisons, Administratif, Finance
  priority    String         @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String         @default("TODO") // TODO, IN_PROGRESS, IN_APPROVAL, DONE, CANCELLED
  dueDate     DateTime?
  checklist   String?        // JSON checklist items
  assignedToId String?
  assignedTo  User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  
  approvals   TaskApproval[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TaskApproval {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  level     Int      @default(1)
  approver  String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  comments  String?
  approvedAt DateTime?
}

